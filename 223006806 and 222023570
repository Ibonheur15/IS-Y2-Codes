public class Loan {
    // Variables for loan details
    private double monthlyPayment;
    private int numberOfYears;
    private double totalAmount;

    // Constructor using the "this" keyword to initialize variables
    public Loan(double monthlyPayment, int numberOfYears, double totalAmount) {
        this.monthlyPayment = monthlyPayment;
        this.numberOfYears = numberOfYears;
        this.totalAmount = totalAmount;
    }

    // Setter methods
    public void setMonthlyPayment(double monthlyPayment) {
        this.monthlyPayment = monthlyPayment;
    }

    public void setNumberOfYears(int numberOfYears) {
        this.numberOfYears = numberOfYears;
    }

    public void setTotalAmount(double totalAmount) {
        this.totalAmount = totalAmount;
    }

    // Getter methods
    public double getMonthlyPayment() {
        return monthlyPayment;
    }

    public int getNumberOfYears() {
        return numberOfYears;
    }

    public double getTotalAmount() {
        return totalAmount;
    }

    // Method to calculate the monthly payment based on loan parameters
    public void calculateMonthlyPayment(double principal, double annualInterestRate) {
        double monthlyInterestRate = annualInterestRate / 12 / 100;
        int totalMonths = this.numberOfYears * 12;

        // Calculating monthly payment using the formula
        this.monthlyPayment = (principal * monthlyInterestRate) / 
                              (1 - Math.pow(1 + monthlyInterestRate, -totalMonths));

        // Calculate the total amount (monthly payment * total number of payments)
        this.totalAmount = this.monthlyPayment * totalMonths;
    }

    public static void main(String[] args) {
        // Example usage
        double principal = 10000; // Loan amount in currency units
        double annualInterestRate = 5; // Annual interest rate in percentage
        int years = 2; // Loan duration in years

        // Create a Loan object with initial values
        Loan myLoan = new Loan(0, years, 0);

        // Calculate the monthly payment and total amount
        myLoan.calculateMonthlyPayment(principal, annualInterestRate);

        // Output the results
        System.out.println("Monthly Payment: " + myLoan.getMonthlyPayment());
        System.out.println("Total Amount to Pay: " + myLoan.getTotalAmount());
    }
}


